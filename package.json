{
	"name": "pi-status",
	"version": "1.0.7",
	"description": "Pi extension: shows green ✓ in terminal title when idle, braille-dot spinner (⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏) while working, with context-usage percentage beside the checkmark",
	"keywords": [
		"status",
		"idle",
		"done",
		"spinner",
		"pi-extension",
		"pi-package"
	],
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AI-Team-26/pi-status"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"pi": {
		"extensions": [
			"./pi-status.ts"
		]
	},
	"devDependencies": {
		"vitest": "^3.2.4"
	}
}
